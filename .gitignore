# ---------------------------------------------------------------
# Large data files — stored in Cloudflare R2, not in git.
# See scripts/r2_sync/README.md for push/pull workflow.
# ---------------------------------------------------------------

# Data directory (local datasets, exports, graphs)
data/
!data/.gitkeep
export_graph/
data/export_graph/

# Extracted / scraped data
extract_data_v2/**/*.json
extract_data_v2/**/*.jsonl
extract_data_v2/**/*.csv
extract_data_v2/**/*.xlsx
extract_data_v2/**/*.parquet

# Processed pipeline output (regenerated by preprocess scripts)
mongo_migration/processed_bukhari_podia/*.jsonl
mongo_migration/processed_bukhari_shamela/*.jsonl
mongo_migration/processed/

# Tarajm crawler output
tarajm/**/*.json
tarajm/**/*.csv
tarajm/**/*.parquet

# Hadith split output
Hadith_split/

# Misc data files in root
neo4j_connection.json
package-lock.json

# Root-level enrichment output JSONL files
/*.jsonl

# Allow frontend source directories that match ignored names
!frontend/src/data/
!frontend/src/lib/

# Debug HTML dumps
debug_html_1681/
debug_html_1681_missing/
debug_html_1681_retry/

# Rotating log files
logs/

# R2 data snapshots (downloaded via scripts/r2_sync/pull_snapshot.py)
data_snapshots/
