MONGODB_URI_READ=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
DB_NAME=HadithData
CORS_ORIGINS=*

# Cloudflare R2 (S3-compatible object storage for data snapshots)
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET=hadathana_data
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=snapshots/
R2_LOCAL_DIR=data_snapshots/
