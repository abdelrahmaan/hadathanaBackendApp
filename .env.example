# ── Environment ──────────────────────────────────────────────────────────────
# "prod" → Atlas cloud + HadithData + port 8000
# "dev"  → local Docker MongoDB + HadithDataDev + port 8001
APP_ENV=prod

# ── MongoDB (prod — Atlas) ────────────────────────────────────────────────────
MONGODB_URI_READ=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_URI_READ_WRITE=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
DB_NAME=HadithData

# ── MongoDB (dev — local Docker) ─────────────────────────────────────────────
MONGODB_URI_LOCAL=mongodb://localhost:27017/
DB_NAME_DEV=HadithDataDev

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
PORT_DEV=8001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://hadathana.app,https://www.hadathana.app
CORS_ORIGINS_DEV=http://localhost:3000,http://localhost:5173

# Embedding + topic tagging (scripts/embed_matn.py) + chatbot LLM
COHERE_API_KEY=
OPENROUTER_API_KEY=

# ── Chatbot ───────────────────────────────────────────────────────────────────
CHATBOT_ENABLED=true                   # set to false to disable chatbot routes + Qdrant entirely
QDRANT_URL=http://qdrant:6333          # internal Docker service name
CHATBOT_MODEL=qwen/qwen3-235b-a22b    # OpenRouter model slug (swappable)

# Cloudflare R2 (S3-compatible object storage for data snapshots)
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET=hadathana_data
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=snapshots/
R2_LOCAL_DIR=data_snapshots/
